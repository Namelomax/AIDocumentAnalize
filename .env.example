POSTGRES_USER=inspector
POSTGRES_PASSWORD=inspector
POSTGRES_DB=inspector
DATABASE_URL=postgresql://inspector:inspector@postgres:5432/inspector
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://inspector:inspector@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=inspector
RABBITMQ_DEFAULT_PASS=inspector
MINIO_ROOT_USER=inspector
MINIO_ROOT_PASSWORD=inspector123
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=documents
JWT_SECRET=change-me-in-production
MAX_FILE_BYTES=62914560
MAX_PACKAGE_BYTES=209715200
LOG_LEVEL=info
TASK_QUEUE=inspector.tasks
DEMO_ADMIN_PASSWORD=admin123
DEMO_INSPECTOR_PASSWORD=inspector123
DEMO_SUPERVISOR_PASSWORD=supervisor123
DEMO_ML_PASSWORD=ml123
JWT_TTL=12h
# Local language model behind an OpenAI-compatible interface (plan 8, worker
# service only). Left blank: the worker runs without a model and reports
# NOT_COMPARABLE for the checks that need one. On the stand this points at
# vLLM; in development on Windows with LM Studio it is
# http://host.docker.internal:1234/v1, with "Serve on Local Network" turned
# on in LM Studio so the worker container can reach the host.
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_S=60
# Grafana's admin account (deploy/monitoring/README.md). Anonymous viewing
# stays off regardless of this value.
GRAFANA_ADMIN_PASSWORD=admin
